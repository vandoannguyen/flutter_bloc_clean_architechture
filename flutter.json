	"Gen base state data": {
		"prefix": "bs",
		"body": [
			"import 'package:base_bloc_module/index.dart';",
			"import 'package:freezed_annotation/freezed_annotation.dart';",
			"",
			"part '$TM_FILENAME_BASE.freezed.dart';",
			"",
			"@Freezed(equal: true)",
			"class ${2:name}State extends BaseDataStateCubit with _$${2:name}State {",
			"  factory ${2:name}State() = _${2:name}State;",
			"}",
			"",
			"@freezed",
			"class ${2:name}Event extends BaseCubitEvent with _$${2:name}Event {",
			"  const factory ${2:name}Event.getData() = GetData;",
			"}"
		],
		"description": "Gen base state data"
	},
